PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Client password recovery email (verified sender in Resend)
RESEND_API_KEY=
PASSWORD_RESET_FROM=
PASSWORD_RESET_EXPIRES_MINUTES=15
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=design_booking_db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
PASSWORD_RESET_EXPIRES_MINUTES=15
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Gmail sender for admin reset links. Use a Google App Password, not the login password.
ADMIN_RECOVERY_GMAIL_USER=
ADMIN_RECOVERY_GMAIL_APP_PASSWORD=
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
PAYMONGO_SECRET_KEY=sk_test_your_paymongo_secret_key
# For deployment set NODE_ENV=production, PAYMENTS_MODE=live, and use sk_live_ credentials.
PAYMENTS_MODE=test
# Signing secret for this environment's /api/payment/webhook endpoint.
PAYMONGO_WEBHOOK_SECRET=

# Dedicated Twilio Verify service for admin password recovery (SMS enabled)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
