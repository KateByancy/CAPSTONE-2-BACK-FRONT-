{
  "name": "design-construction-booking-api",
  "version": "1.0.0",
  "description": "Backend API for Design/Construction Service Booking App",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:backend": "nodemon server.js",
    "db:init": "node createDatabase.js && node createTables.js",
    "db:migrate": "node createTables.js",
    "db:migrate:gcash": "node migrateGcash.js",
    "test:gcash": "node tests/gcash.test.js",
    "test:payments-production": "node tests/paymentsProduction.test.js",
    "payments:check": "node checkPayments.js",
    "db:migrate:avatars": "node migrateAvatars.js",
    "test:avatars": "node tests/avatar.test.js",
    "check": "node --check server.js && node --check config/db.js && node --check createDatabase.js && node --check createTables.js && node --check controllers/authController.js && node --check middeware/auth.js && node --check middeware/errorHandler.js && node --check middeware/validation.js && node --check routes/authRoutes.js && node --check routes/profileRoutes.js && node --check utils/authTokens.js",
    "db:migrate:admin-sms": "node migrateAdminSmsReset.js",
    "sms:check": "node checkAdminSms.js",
    "admin-email:check": "node checkAdminEmail.js",
    "db:migrate:admin-email": "node migrateAdminEmailReset.js",
    "test:admin-email": "node tests/adminEmailReset.test.js",
    "db:migrate:client-email": "node migrateClientEmailCode.js",
    "test:client-email": "node tests/clientEmailCode.test.js",
    "test:admin-sms": "node tests/adminSmsReset.test.js",
    "test:password-recovery": "node tests/passwordRecoveryRoutes.test.js",
    "build": "npm run check"
  },
  "keywords": [
    "express",
    "mysql",
    "sequelize",
    "booking"
  ],
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.5",
    "nodemailer": "^10.0.10",
    "sequelize": "^6.37.3",
    "socket.io": "^4.7.5",
    "stripe": "^16.12.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
